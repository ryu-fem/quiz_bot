# توكن البوت من @BotFather
BOT_TOKEN=123456:ABC-your-token
# الـ user id بتاعك (من أمر /id). لو أكتر من واحد افصل بفاصلة
ADMIN_IDS=123456789

# مفاتيح مجانية: حط واحد على الأقل (كل ما تحط أكتر، الاحتياطي أقوى)
GROQ_API_KEY=            # console.groq.com
CEREBRAS_API_KEY=        # cloud.cerebras.ai
MISTRAL_API_KEY=         # console.mistral.ai
OPENROUTER_API_KEY=      # openrouter.ai/keys
GEMINI_API_KEY=          # aistudio.google.com/apikey

# اختياري: ترتيب التجربة (الأول هو الأساسي)
PROVIDER_ORDER=groq,cerebras,mistral,openrouter,gemini
# اختياري: لو اسم موديل اتغير عند المزود، غيره هنا
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=gpt-oss-120b
# MISTRAL_MODEL=mistral-small-latest
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# GEMINI_MODEL=gemini-3.8-flash
