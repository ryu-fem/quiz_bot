# توكن البوت من @BotFather
BOT_TOKEN=123456:ABC-your-token
# الـ user id بتاعك (من أمر /id). لو أكتر من واحد افصل بفاصلة
ADMIN_IDS=123456789

# مفاتيح مجانية: حط واحد على الأقل (كل ما تحط أكتر، الاحتياطي أقوى)
GROQ_API_KEY=            # console.groq.com
CEREBRAS_API_KEY=        # cloud.cerebras.ai
MISTRAL_API_KEY=         # console.mistral.ai
OPENROUTER_API_KEY=      # openrouter.ai/keys
GEMINI_API_KEY=          # aistudio.google.com/apikey

# اختياري: ترتيب التجربة (الأول هو الأساسي)
PROVIDER_ORDER=groq,cerebras,mistral,openrouter,gemini
# اختياري: لو اسم موديل اتغير عند المزود، غيره هنا
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=gpt-oss-120b
# MISTRAL_MODEL=mistral-small-latest
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# GEMINI_MODEL=gemini-3.8-flash

# اختياري (مفيد في الاستضافة): مكان النشر والعنوان الافتراضي
# TARGET_CHAT=@channel_username
# DEFAULT_PREFIX=🔥 Grammar

# اختياري: مسار ملف الإعدادات (على Railway لو ضفت Volume على /data خليه /data/config.json)
# CONFIG_PATH=/data/config.json

# ---- الوصول والحدود (اختياري)
# البوت مفتوح لأي حد افتراضيًا. اكتب false لو عايزه للأدمن بس
# OPEN_ACCESS=true
# أقصى عدد رسائل AI في اليوم للمستخدم العادي (الأدمن من غير حد)
# USER_DAILY_LIMIT=15
# أقصى حجم رسالة للمستخدم العادي بالحروف
# USER_MAX_CHARS=15000
# عدد طلبات الـ AI اللي بتتنفذ في نفس الوقت
# AI_CONCURRENCY=3
